:name: Duet 3 MB6HC function trace, CRC-valid image
:description: Loads the CRC-appended .bin (which is what a real board runs) and traces where it gets to.

mach create "duet3_mb6hc"
machine LoadPlatformDescription @platforms/cpus/sam_e70.repl

# The .bin is the artefact the CRC covers; the .elf only supplies symbols.
sysbus LoadBinary $fw 0x400000
sysbus LoadSymbolsFrom $elf
cpu VectorTableOffset 0x400000
cpu PC `sysbus ReadDoubleWord 0x400004`
cpu SP `sysbus ReadDoubleWord 0x400000`

logLevel 3 sysbus
logFile $logfile true
cpu LogFunctionNames true

emulation RunFor "0.05"
quit
